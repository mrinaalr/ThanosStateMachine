# Thanos campaign expressed in the CaseNoesis trajectory vocabulary.
#
# Deliberately does NOT use uco-observable / case-investigation classes:
# this is a fictional kinetic campaign, and the point of the exercise is
# that the traj: layer alone should carry it. Where it can't, that is a
# finding — see docs/ONTOLOGY.md.
#
# GENERATED by scripts/export_ttl.py from build_machine().
# Do not hand-edit structural states/actions/transitions; re-run the
# exporter. Parity is enforced by tests/test_ttl_parity.py.
#
# Source material (prov:wasDerivedFrom): Avengers: Infinity War (2018),
# Avengers: Endgame (2019). No day-level times are fabricated; intervals
# are film-scoped.

@prefix traj: <https://casenoesis.org/ontology/trajectory#> .
@prefix tsm:  <https://github.com/mrinaalr/ThanosStateMachine#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .


# ---------------------------------------------------------------------------
# Source documents
# ---------------------------------------------------------------------------

tsm:src-infinity-war a prov:Entity ;
    rdfs:label "Avengers: Infinity War (2018), Marvel Studios" .

tsm:src-endgame a prov:Entity ;
    rdfs:label "Avengers: Endgame (2019), Marvel Studios" .

# ---------------------------------------------------------------------------
# Exogenous prior acquisition (mirrors elder_scheme.ttl)
# ---------------------------------------------------------------------------

tsm:activity-xandar a prov:Activity ;
    rdfs:label "Power Stone acquisition (Xandar); exogenous, pre-s0" ;
    prov:wasDerivedFrom tsm:src-infinity-war .

# ---------------------------------------------------------------------------
# States
# ---------------------------------------------------------------------------

tsm:CampaignInitiation a traj:State ;
    traj:phaseLabel "InitialContactPhase" ; traj:layer "campaign" .

tsm:SnapEvent a traj:State ;
    traj:phaseLabel "ExploitationPhase" ; traj:layer "campaign" ; rdfs:comment "Terminal harm event of the 2018 trajectory; interior state of the 2018-2023 composite trajectory." .

tsm:GardenWithdrawal a traj:State ;
    traj:phaseLabel "MaintenancePhase" ; traj:layer "campaign" ; rdfs:comment "Stone destruction as harm maintenance: making the completed exploitation irreversible." .

tsm:RemediationBattle a traj:State ;
    traj:layer "campaign" .

tsm:CampaignRemediated a traj:State ;
    traj:layer "campaign" .

tsm:StatesmanIntercept a traj:State ;
    traj:phaseLabel "InitialContactPhase" ; traj:layer "space" .

tsm:LokiCoercion a traj:State ;
    traj:phaseLabel "ConditioningPhase" ; traj:layer "space" ; rdfs:comment "Hostage leverage: Thor's life against the Tesseract." .

tsm:SpaceExtraction a traj:State ;
    traj:phaseLabel "ExploitationPhase" ; traj:layer "space" .

tsm:KnowhereApproach a traj:State ;
    traj:phaseLabel "InitialContactPhase" ; traj:layer "reality" .

tsm:CollectorConcealment a traj:State ;
    traj:phaseLabel "ConditioningPhase" ; traj:layer "reality" .

tsm:RealityExtraction a traj:State ;
    traj:phaseLabel "ExploitationPhase" ; traj:layer "reality" .

tsm:VormirApproach a traj:State ;
    traj:phaseLabel "InitialContactPhase" ; traj:layer "soul" .

tsm:GamoraLeverage a traj:State ;
    traj:phaseLabel "ConditioningPhase" ; traj:layer "soul" ; rdfs:comment "Affordance accumulation: Reality Stone (prior extraction) defeats Gamora's suicide attempt." .

tsm:SoulExtraction a traj:State ;
    traj:phaseLabel "ExploitationPhase" ; traj:layer "soul" .

tsm:TitanAmbush a traj:State ;
    traj:phaseLabel "InitialContactPhase" ; traj:layer "time" .

tsm:StrangeBargain a traj:State ;
    traj:phaseLabel "ConditioningPhase" ; traj:layer "time" ; rdfs:comment "Hostage leverage: Stark's life against the Eye of Agamotto." .

tsm:TimeExtraction a traj:State ;
    traj:phaseLabel "ExploitationPhase" ; traj:layer "time" .

tsm:WakandaAssault a traj:State ;
    traj:phaseLabel "InitialContactPhase" ; traj:layer "mind" .

tsm:DefensePenetration a traj:State ;
    traj:phaseLabel "ConditioningPhase" ; traj:layer "mind" .

tsm:MindExtraction a traj:State ;
    traj:phaseLabel "ExploitationPhase" ; traj:layer "mind" ; rdfs:comment "Affordance accumulation: Time Stone reverses the Mind Stone's destruction." .

# ---------------------------------------------------------------------------
# Actions / affordances
# ---------------------------------------------------------------------------

tsm:a_fleet a traj:Action ; rdfs:label "Sanctuary II / Outrider armies" .

tsm:a_black_order a traj:Action ; rdfs:label "delegated acquisition (Children of Thanos)" .

tsm:a_hostage_leverage a traj:Action ; rdfs:label "coerce stone-holder via a hostage (Thor->Loki, Tony->Strange, Gamora->Soul)" .

tsm:a_deception a traj:Action ; rdfs:label "staged scene / concealment (Knowhere illusion)" .

tsm:a_sacrifice_rite a traj:Action ; rdfs:label "Vormir exchange: a soul for the Soul Stone" .

tsm:a_power_stone a traj:Action ; tsm:affordance true ; rdfs:label "acquired pre-s0 (Xandar, exogenous)" .

tsm:a_space_skip a traj:Action ; tsm:affordance true ; rdfs:label "portal arrival anywhere (Space Stone)" ; tsm:unlockedBy tsm:SpaceExtraction .

tsm:a_reality_warp a traj:Action ; tsm:affordance true ; rdfs:label "rewrite local reality (Reality Stone)" ; tsm:unlockedBy tsm:RealityExtraction .

tsm:a_time_reverse a traj:Action ; tsm:affordance true ; rdfs:label "rewind events (Time Stone)" ; tsm:unlockedBy tsm:TimeExtraction .

tsm:a_snap a traj:Action ; rdfs:label "terminal harm event: erase half of all life" .

tsm:a_stone_destruction a traj:Action ; rdfs:label "destroy the stones to make the harm irreversible" .

tsm:a_time_heist a traj:Action ; tsm:guardianIntervention true ; rdfs:label "guardian remediation: quantum-tunnel retrieval of past stones" .

tsm:a_reverse_snap a traj:Action ; tsm:guardianIntervention true ; rdfs:label "Hulk snap: restore the erased" .

tsm:a_counter_snap a traj:Action ; tsm:guardianIntervention true ; rdfs:label "Stark snap: erase the 2014 invasion force" .

# ---------------------------------------------------------------------------
# Transitions — derived 1:1 from build_machine()
# ---------------------------------------------------------------------------

tsm:t-01-StatesmanIntercept-to-LokiCoercion a traj:Transition ;
    traj:fromState tsm:StatesmanIntercept ;
    traj:toState tsm:LokiCoercion ;
    traj:enactsAction tsm:a_fleet, tsm:a_power_stone, tsm:a_black_order .

tsm:t-02-LokiCoercion-to-SpaceExtraction a traj:Transition ;
    traj:fromState tsm:LokiCoercion ;
    traj:toState tsm:SpaceExtraction ;
    traj:enactsAction tsm:a_hostage_leverage .

tsm:t-03-SpaceExtraction-to-SnapEvent a traj:Transition ;
    traj:fromState tsm:SpaceExtraction ;
    traj:toState tsm:SnapEvent ;
    traj:trigger "stone socketed into gauntlet" .

tsm:t-04-KnowhereApproach-to-CollectorConcealment a traj:Transition ;
    traj:fromState tsm:KnowhereApproach ;
    traj:toState tsm:CollectorConcealment ;
    traj:enactsAction tsm:a_space_skip .

tsm:t-05-CollectorConcealment-to-RealityExtraction a traj:Transition ;
    traj:fromState tsm:CollectorConcealment ;
    traj:toState tsm:RealityExtraction ;
    traj:enactsAction tsm:a_deception .

tsm:t-06-RealityExtraction-to-SnapEvent a traj:Transition ;
    traj:fromState tsm:RealityExtraction ;
    traj:toState tsm:SnapEvent ;
    traj:trigger "stone socketed into gauntlet" .

tsm:t-07-VormirApproach-to-GamoraLeverage a traj:Transition ;
    traj:fromState tsm:VormirApproach ;
    traj:toState tsm:GamoraLeverage ;
    traj:enactsAction tsm:a_space_skip .

tsm:t-08-GamoraLeverage-to-SoulExtraction a traj:Transition ;
    traj:fromState tsm:GamoraLeverage ;
    traj:toState tsm:SoulExtraction ;
    traj:enactsAction tsm:a_hostage_leverage, tsm:a_reality_warp ;
    rdfs:comment "Edge labelled by an affordance unlocked in a SIBLING layer: the layered extension permits this; nothing in traj: requires A to be static." .

tsm:t-09-SoulExtraction-to-SnapEvent a traj:Transition ;
    traj:fromState tsm:SoulExtraction ;
    traj:toState tsm:SnapEvent ;
    traj:enactsAction tsm:a_sacrifice_rite ;
    traj:trigger "stone socketed into gauntlet" .

tsm:t-10-TitanAmbush-to-StrangeBargain a traj:Transition ;
    traj:fromState tsm:TitanAmbush ;
    traj:toState tsm:StrangeBargain ;
    traj:enactsAction tsm:a_space_skip .

tsm:t-11-StrangeBargain-to-TimeExtraction a traj:Transition ;
    traj:fromState tsm:StrangeBargain ;
    traj:toState tsm:TimeExtraction ;
    traj:enactsAction tsm:a_hostage_leverage .

tsm:t-12-TimeExtraction-to-SnapEvent a traj:Transition ;
    traj:fromState tsm:TimeExtraction ;
    traj:toState tsm:SnapEvent ;
    traj:trigger "stone socketed into gauntlet" .

tsm:t-13-WakandaAssault-to-DefensePenetration a traj:Transition ;
    traj:fromState tsm:WakandaAssault ;
    traj:toState tsm:DefensePenetration ;
    traj:enactsAction tsm:a_space_skip, tsm:a_fleet, tsm:a_black_order .

tsm:t-14-DefensePenetration-to-MindExtraction a traj:Transition ;
    traj:fromState tsm:DefensePenetration ;
    traj:toState tsm:MindExtraction ;
    traj:enactsAction tsm:a_fleet .

tsm:t-15-MindExtraction-to-SnapEvent a traj:Transition ;
    traj:fromState tsm:MindExtraction ;
    traj:toState tsm:SnapEvent ;
    traj:enactsAction tsm:a_time_reverse ;
    traj:trigger "stone socketed into gauntlet" ;
    prov:wasDerivedFrom tsm:src-infinity-war .

tsm:t-16-CampaignInitiation-to-StatesmanIntercept a traj:Transition ;
    traj:fromState tsm:CampaignInitiation ;
    traj:toState tsm:StatesmanIntercept ;
    traj:enactsAction tsm:a_power_stone ;
    traj:trigger "Xandar complete (exogenous)" ;
    prov:wasDerivedFrom tsm:src-infinity-war .

tsm:t-17-SnapEvent-to-GardenWithdrawal a traj:Transition ;
    traj:fromState tsm:SnapEvent ;
    traj:toState tsm:GardenWithdrawal ;
    traj:enactsAction tsm:a_snap ;
    prov:wasDerivedFrom tsm:src-endgame .

tsm:t-18-GardenWithdrawal-to-RemediationBattle a traj:Transition ;
    traj:fromState tsm:GardenWithdrawal ;
    traj:toState tsm:RemediationBattle ;
    traj:enactsAction tsm:a_stone_destruction, tsm:a_time_heist, tsm:a_reverse_snap ;
    traj:trigger "guardian remediation, five years later" ;
    prov:wasDerivedFrom tsm:src-endgame .

tsm:t-19-RemediationBattle-to-CampaignRemediated a traj:Transition ;
    traj:fromState tsm:RemediationBattle ;
    traj:toState tsm:CampaignRemediated ;
    traj:enactsAction tsm:a_counter_snap ;
    prov:wasDerivedFrom tsm:src-endgame .

# ---------------------------------------------------------------------------
# Trajectories
# ---------------------------------------------------------------------------

tsm:trajectory-2018 a traj:Trajectory ;
    rdfs:label "Stone campaign through the Snap" ;
    traj:terminalState tsm:SnapEvent ;
    traj:terminalPolarity "completed" ;
    prov:wasDerivedFrom tsm:src-infinity-war .

tsm:trajectory-2018-2023 a traj:Trajectory ;
    rdfs:label "Stone campaign through the Snap, its maintenance, and its reversal" ;
    traj:terminalState tsm:CampaignRemediated ;
    traj:terminalPolarity "remediated" ;
    rdfs:comment "STRESS FINDING: not expressible in the binary completed/disrupted range of traj:terminalPolarity. The harm state was reached AND subsequently reversed. Elder-scheme polarity assumes disruption happens before completion; this case falsifies that assumption at the vocabulary level." ;
    prov:wasDerivedFrom tsm:src-endgame .
